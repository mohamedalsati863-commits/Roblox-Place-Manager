/* إعدادات الخطوط والصفحة العامة */
body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #0f172a; /* خلفية داكنة تناسب طابع الألعاب */
    color: #f8fafc;
    margin: 0;
    padding: 20px;
    direction: rtl;
}

/* عنوان الصفحة الرئيسي */
.main-title {
    text-align: center;
    color: #38bdf8;
    font-size: 2rem;
    margin-bottom: 30px;
}

/* شبكة تقسيم المحتوى */
.content-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    max-width: 1200px;
    margin: 0 auto;
}

/* بطاقات الأخبار والفيديوهات */
.card {
    background-color: #1e293b;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    border: 1px solid #334155;
}

.card h2 {
    color: #f59e0b;
    font-size: 1.25rem;
    margin-top: 0;
    margin-bottom: 15px;
    border-bottom: 2px solid #334155;
    padding-bottom: 10px;
}

/* جعل الفيديوهات متجاوبة مع الشاشات */
.video-responsive {
    position: relative;
    padding-bottom: 56.25%; /* نسبة 16:9 */
    height: 0;
    overflow: hidden;
    border-radius: 8px;
}

.video-responsive iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
}
