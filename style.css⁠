body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #0f172a;
    color: #f8fafc;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-content: center;
    min-height: 100vh;
    direction: rtl;
}

.container {
    background-color: #1e293b;
    padding: 30px;
    border-radius: 16px;
    text-align: center;
    width: 90%;
    max-width: 450px;
    margin: auto;
    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    border: 1px solid #334155;
}

h1 {
    color: #38bdf8;
    font-size: 1.4rem;
}

.controls {
    display: flex;
    gap: 10px;
    justify-content: center;
    margin: 20px 0;
}

.btn {
    border: none;
    padding: 12px 24px;
    font-size: 1rem;
    font-weight: bold;
    border-radius: 8px;
    cursor: pointer;
    transition: 0.2s;
    color: white;
}

.btn-start {
    background-color: #22c55e;
}

.btn-start:hover:not(:disabled) {
    background-color: #16a34a;
}

.btn-stop {
    background-color: #ef4444;
}

.btn-stop:hover:not(:disabled) {
    background-color: #dc2626;
}

.btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

/* قائمة الأسماء */
.list-box {
    background-color: #0f172a;
    border: 1px solid #334155;
    border-radius: 8px;
    height: 300px;
    overflow-y: auto;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.placeholder {
    color: #64748b;
    margin: auto;
}

.user-item {
    background-color: #1e293b;
    border: 1px solid #334155;
    padding: 8px 15px;
    border-radius: 6px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.username-text {
    font-size: 1.3rem;
    font-weight: bold;
    color: #f59e0b;
    letter-spacing: 2px;
}

/* زر النسخ */
.btn-copy {
    background-color: #38bdf8;
    color: #0f172a;
    border: none;
    padding: 6px 14px;
    font-size: 0.85rem;
    font-weight: bold;
    border-radius: 6px;
    cursor: pointer;
    transition: 0.2s;
}

.btn-copy:hover {
    background-color: #0284c7;
    color: white;
}

.btn-copy.copied {
    background-color: #22c55e;
    color: white;
}
